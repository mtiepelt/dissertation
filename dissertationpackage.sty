% -------------------------------------------------------------
%   HYPERREF SETUP
%   ! LOADING HYPERREF SEPERATELY WILL BREAK PDF-A FORMAT !
% -------------------------------------------------------------
% loads hyperref and xolor internally. Must be loadded 'last'
%\usepackage[a-1b]{pdfx}
\usepackage[a-3b,mathxmp]{pdfx}
% NOTE: Meta-data is included via the `diss.xmpdata' file.

% Load after hyperref and xcolor to preserve settings
\usepackage{orcidlink} 

\hypersetup{%
    linktoc=page, % {all, page}
    bookmarks=true,
    bookmarksdepth = section,
    colorlinks = true, % false, % FALSE FOR PRINTING
    linkcolor = Burgundy,
    urlcolor = Burgundy,
    citecolor = Burgundy,
    filecolor = Burgundy, 
    runcolor = Burgundy, 
    pdfpagelayout=TwoPageLeft,
    plainpages=false, % http://tex.lickert.net/tipps/destination/index.html
    pdfpagelabels, 
    %
    %hidelinks  % FOR PRINTING 
}



% Change acronym link color to black (FOR PRINTING, if one wants other references to be colored.)
% \renewcommand*{\glstextformat}[1]{\textcolor{Black}{#1}} 


% Glossaries need to be loaded AFTER hypersetup, or forward links are broken
\RequirePackage[acronym
   % shortcuts,% enable acronym-like commands
   % nogroupskip,% suppress gap between letter groups
   % nopostdot% suppress terminating full stop after descriptions
   ]{glossaries}
\makeglossaries

